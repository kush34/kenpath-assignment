# API server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:change-me-local@localhost:5432/sweety
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional cache and reminder worker (worker requires REDIS_URL)
REDIS_URL=redis://localhost:6379
REMINDER_TIMEZONE=Asia/Kolkata

# Vite development proxy / optional direct API URL
VITE_PROXY_TARGET=http://127.0.0.1:4000
VITE_API_URL=

# Docker Compose host ports (separate from local npm development)
API_PORT=4001
CLIENT_PORT=5174

# Docker Compose PostgreSQL settings
POSTGRES_DB=sweety
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local
