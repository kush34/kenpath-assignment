{
  "name": "sweety-glucose-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite client --config client/vite.config.js",
    "build": "vite build client --config client/vite.config.js",
    "start": "node server/index.js",
    "worker": "node server/worker.js",
    "db:seed": "node server/seed.js",
    "test": "node server/validation.test.js && npm run test:client",
    "test:client": "vitest run --config client/vitest.config.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^6.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "jsdom": "^25.0.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
